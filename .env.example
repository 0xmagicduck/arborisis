# Copier en .env (jamais commité, voir .gitignore) pour le développement local.
# Démarrer les dépendances : docker compose up -d (voir docker-compose.yml).

NODE_ENV=development

# --- apps/api ---
PORT=4000
DATABASE_URL=postgres://arborisis:arborisis@localhost:5432/arborisis
REDIS_URL=redis://localhost:6379
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Arborisis
WEBAUTHN_ORIGIN=http://localhost:3000

# Mode intérimaire — reste "false" tant qu'Internet Archive n'est pas
# accessible (seuil de 50 items déjà publiés, voir plan/05-stockage-audio-internet-archive.md §5.10).
ARCHIVE_TO_IA=false

# --- Object Storage (S3-compatible) ---
# En local : MinIO (docker compose up -d, voir docker-compose.yml).
# En prod : Object Storage Infomaniak — endpoint Swift/S3-compat de la région
# (ex. https://s3.pub1.infomaniak.cloud), credentials EC2 générées via
# `openstack ec2 credentials create` (voir plan/04-infra-infomaniak.md §4.1).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# "us-east-1" toujours, même en prod contre Infomaniak — PAS la région
# OpenStack (dc3-a/dc4-a), qui n'a aucun rôle ici : c'est l'`endpoint`
# ci-dessus qui détermine la région physique. Vérifié en conditions réelles :
# leur passerelle S3-compat rejette toute autre valeur pour la signature SigV4
# (`AuthorizationHeaderMalformed`), voir @arborisis/storage StorageConfig.
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=arborisis-storage
OBJECT_STORAGE_ACCESS_KEY_ID=arborisis-dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=arborisis-dev-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=524288000
# Optionnel — laisser vide en dev (MinIO répond correctement aux préflights
# CORS). En prod, défini par infra/docker-compose.yml à partir de
# ARBORISIS_DOMAIN (contourne le CORS cassé côté Infomaniak sur les PUT
# pré-signés, voir infra/caddy/Caddyfile et plan/MEMORY.md).
# OBJECT_STORAGE_UPLOAD_PROXY_URL=https://arborisis.com/storage-upload

# --- apps/worker : binaires système, voir plan/05 §5.3 ---
# Par défaut "ffmpeg"/"ffprobe" résolus via PATH (brew install ffmpeg en local).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# Fichier de tuiles vectorielles (Phase 4-5, voir plan/07-carte-open-source.md
# §7.4 et infra/tiles/README.md). Par défaut : same-origin, servi par Next.js
# depuis apps/web/public/tiles/ (généré via infra/tiles/generate.sh, jamais
# commité — voir .gitignore). Déposé en Phase 5 sur un container Object
# Storage public dédié (`arborisis-tiles`) — mais **pas appelé directement**
# par le navigateur : le bucket Infomaniak n'envoie aucun en-tête CORS
# exploitable (ACL Swift publique et `PutBucketCors` S3-compatible testés en
# conditions réelles, aucun des deux ne fonctionne — voir infra/caddy/Caddyfile
# et plan/TASKS.md). Caddy proxifie `/tiles/*` vers le bucket en production
# (same-origin, pas de CORS nécessaire, Range requests vérifiées) : la valeur
# reste donc `/tiles/luxembourg.pmtiles` en production aussi, résolue
# différemment (Next.js en dev, Caddy en prod) — aucun changement de code ni
# de config ici entre les deux.
NEXT_PUBLIC_PMTILES_URL=/tiles/luxembourg.pmtiles

# Géocodage (Phase 4 bootstrap → Phase 5 auto-hébergé, voir plan/07 §7.5) —
# côté API désormais (PHOTON_URL plus bas, pas ici) : depuis Phase 5, le
# navigateur ne parle plus à Photon directement, voir apps/web/lib/geocoding.ts
# et infra/photon/README.md.

# --- Meilisearch (Phase 4) ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-only-master-key

# --- Géocodage côté API (Phase 5, voir plan/07 §7.5) ---
# Défaut = instance publique de démonstration Photon (komoot), identique au
# comportement Phase 4. En production, pointer vers l'instance auto-hébergée
# sur son réseau privé (voir infra/photon/README.md), jamais exposée
# publiquement.
PHOTON_URL=https://photon.komoot.io/api

# --- Sauvegardes (Phase 5, voir plan/04 §4.5 et infra/backup/README.md) ---
# 16 caractères minimum. Générer avec `openssl rand -base64 32`, stocker hors
# du repo (gestionnaire de secrets / coffre séparé) — la perte de cette
# passphrase rend les sauvegardes existantes irrécupérables.
BACKUP_GPG_PASSPHRASE=

# --- Modération (Phase 5, voir plan/10 §10.3) ---
# Handles séparés par des virgules autorisés à lister/résoudre les
# signalements (GET/PATCH /reports) — pas de rôle admin en base, voir
# apps/api/src/lib/admin.ts. Vide par défaut : les routes de revue répondent
# 403 tant qu'aucun handle n'est listé ici.
ADMIN_HANDLES=
