{
  "name": "arborisis",
  "private": true,
  "version": "0.0.0",
  "description": "Archive sonore naturaliste, géographique et communautaire — monorepo.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @arborisis/db generate",
    "db:migrate": "pnpm --filter @arborisis/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<8.5.23": ">=8.5.23"
    }
  }
}
