# Caddyfile — Phase 6 : bascule vers la config de production, voir
# plan/11-roadmap.md ("Bascule DNS finale sur arborisis.com") et
# infra/README.md. Le bloc hello-world de la Phase 0 reste ci-dessous,
# commenté, comme trace — voir plan/04-infra-infomaniak.md §4.3/§4.4 pour son
# historique (validation domaine → DNS → VM → TLS).

# {$ARBORISIS_DOMAIN} {
# 	root * /srv/hello-world
# 	file_server
# 	encode gzip
#
# 	log {
# 		output stdout
# 		format console
# 	}
# }

{$ARBORISIS_DOMAIN} {
	# handle_path (pas handle) : retire le préfixe /api avant de transmettre
	# à l'API — ses routes (/auth/..., /recordings/...) n'ont elles-mêmes
	# aucun préfixe /api, voir apps/api/src/app.ts. NEXT_PUBLIC_API_URL=/api
	# côté web (voir infra/docker-compose.yml .env prod) pour rester
	# same-origin — pas de CORS nécessaire, cookie de session utilisable
	# sans configuration cross-site.
	handle_path /api/* {
		reverse_proxy api:4000
	}

	# Tuiles PMTiles servies same-origin plutôt qu'en pointant directement
	# le navigateur vers l'URL de l'Object Storage — voir infra/photon et
	# plan/07 §7.4 ("https://tiles.arborisis.com/..." impliquait déjà un
	# sous-domaine/proxy, pas une exposition brute du bucket). Raison
	# concrète découverte en Phase 5 : le container Object Storage
	# Infomaniak public n'envoie aucun en-tête CORS exploitable par
	# MapLibre (testé en conditions réelles — ni l'ACL de lecture publique
	# Swift ni `PutBucketCors` côté API S3-compatible, qui répond
	# `501 NotImplemented`, ne suffisent). Le proxy Caddy rend la question
	# sans objet (same-origin, pas de CORS nécessaire), tout en supportant
	# nativement les requêtes `Range` (nécessaires à PMTiles).
	handle_path /tiles/* {
		rewrite * /object/v1/AUTH_d1267b24f6994ea8abf2cc88b96c5c06/arborisis-tiles{uri}
		reverse_proxy https://s3.pub1.infomaniak.cloud {
			header_up Host s3.pub1.infomaniak.cloud
		}
	}
	# Vérifié en conditions réelles (2026-08-20, voir plan/TASKS.md) : `caddy
	# validate` sur ce bloc + une instance Caddy locale réelle (Docker,
	# écoute sur :8080) interrogée avec une vraie requête `Range` contre le
	# vrai bucket `arborisis-tiles` — `206 Partial Content` correct reçu.

	# Proxy same-origin pour les uploads PUT pré-signés — bug réel trouvé en
	# prod (2026-08-20, voir plan/MEMORY.md) : la passerelle S3-compat
	# Infomaniak ne répond pas correctement aux préflights CORS (OPTIONS →
	# 405) pour un PUT envoyé directement depuis le navigateur vers
	# s3.pub1.infomaniak.cloud, contrairement à MinIO en dev. Même limitation
	# déjà rencontrée pour /tiles/* en Phase 5 (CORS Infomaniak indisponible).
	# `OBJECT_STORAGE_UPLOAD_PROXY_URL=https://{$ARBORISIS_DOMAIN}/storage-upload`
	# (apps/api/src/config.ts) fait réécrire l'origine de l'URL pré-signée
	# vers ce chemin — le chemin `/arborisis-storage/...` et la querystring de
	# signature SigV4 sont préservés tels quels par `handle_path`.
	handle_path /storage-upload/* {
		reverse_proxy https://s3.pub1.infomaniak.cloud {
			header_up Host s3.pub1.infomaniak.cloud
		}
	}

	handle {
		reverse_proxy web:3000
	}

	# En-têtes de sécurité (Phase 5 durcissement, voir
	# plan/10-securite-confidentialite-conformite.md). HSTS géré par Caddy
	# via son support natif (activé automatiquement avec TLS auto) — inutile
	# de le redéclarer ici, Caddy l'envoie déjà par défaut sur les domaines
	# avec certificat géré.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
		# CSP écrite pour les besoins connus de la stack : MapLibre GL (WebGL +
		# web workers via blob:), polices auto-hébergées (next/font, pas de CDN),
		# API même origine, tuiles PMTiles/audio proxy sur l'Object Storage
		# Infomaniak.
		#
		# media-src ... blob: : ajouté après un bug réel en production — le
		# flux Ajouter prévisualise le fichier local choisi via
		# `URL.createObjectURL` (apps/web/app/ajouter/StepDetails.tsx,
		# local-probe.ts) avant tout upload, lu par le lecteur `<audio>`
		# partagé. Sans `blob:` ici, la prévisualisation était bloquée par la
		# CSP (jamais testée en navigateur réel avant la bascule Phase 6).
		#
		# script-src 'unsafe-inline' : le Caddyfile prévoyait initialement
		# `script-src 'self'` seul (non vérifié en conditions réelles avant la
		# bascule Phase 6, voir la note retirée ci-dessus) — **page blanche en
		# production** au premier test réel : Next.js App Router injecte des
		# `<script>` inline pour le payload de streaming/hydratation RSC à
		# chaque page, bloqués sans `'unsafe-inline'` ou un nonce par requête.
		# Corrigé en urgence avec `'unsafe-inline'` (affaiblit la CSP contre
		# l'injection de script, mais reste `default-src 'self'` pour tout le
		# reste). À remplacer par une CSP à base de nonce par requête
		# (middleware Next.js + en-tête généré dynamiquement plutôt que statique
		# dans ce Caddyfile) — non fait ici, voir plan/MEMORY.md.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.pub1.infomaniak.cloud; media-src 'self' blob: https://*.pub1.infomaniak.cloud; connect-src 'self' https://*.pub1.infomaniak.cloud; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}
}
